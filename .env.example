# BZOD Platform Configuration
HOST=0.0.0.0
PORT=8080
DATA_DIR=./data

# Security Settings
COOKIE_SECURE=false
SESSION_SECRET=bzod-default-session-secret-change-me-in-production-please-do-it

# Bootstrap Admin Credentials
ADMIN_USERNAME=admin
# REQUIRED for a fresh deployment.
# Use a strong unique password.
ADMIN_PASSWORD=

# Cron & Cleaner Intervals (in minutes)
LINK_CHECK_INTERVAL_MINS=60
AGGREGATION_INTERVAL_MINS=60
DATA_RETENTION_DAYS=365
